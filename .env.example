# Google Maps API Key for high-rate authenticated XYZ tiles (roadmap, satellite, hybrid, terrain)
GOOGLE_MAPS_API_KEY=

# Cesium Ion Access Token for 3D terrain and Bing Maps aerial imagery assets
CESIUM_ION_TOKEN=

# OpenSky Network OAuth2 credentials for authenticated ADS-B flight feeds
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# NASA FIRMS MAP Key for live Near Real-Time (NRT) active wildfire thermal anomalies
FIRMS_MAP_KEY=

# AISStream API Key for real-time global maritime AIS ship tracking
AISSTREAM_API_KEY=

# TomTom Traffic API Key for real-time traffic flow raster overlays
TOMTOM_API_KEY=
